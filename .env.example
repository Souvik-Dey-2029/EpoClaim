# ==============================================================================
# EpoClaim — Unified Environment Configuration Template
# Global AI Hackathon — PS06: Stale-Answer Detector
# ==============================================================================
# This template documents all environment variables used by EpoClaim across
# local development, automated testing, and Render production deployments.
#
# LOCAL USAGE:
#   Copy this file to `.env` in the repository root for single-file local configuration:
#     cp .env.example .env
#   The FastAPI backend will automatically discover and load the root `.env`.
#   The Vite frontend will automatically read public `VITE_` variables from `.env`.
#
# RENDER BLUEPRINT USAGE:
#   When deploying via `render.yaml`, Render manages environment variables in
#   cloud Environment Groups and Service configurations. Secrets marked `sync: false`
#   are requested once in the Render Dashboard wizard during Blueprint creation.
#
# SECURITY NOTICE:
#   - NEVER commit real credentials, tokens, or API keys to version control.
#   - NEVER expose private keys (Gemini, Tavily, Bifrost, API keys) to the frontend.
#   - ONLY variables prefixed with `VITE_` are exposed to frontend client code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & RUNTIME (Backend)
# ------------------------------------------------------------------------------
# ENVIRONMENT
# Purpose: Operating environment mode.
# Values: development | staging | production
# Owning Service: Backend Web Service
# Default: development (local) / production (Render)
ENVIRONMENT=development

# APP_DEBUG
# Purpose: Enable verbose debug logging and auto-reload capabilities.
# Values: true | false
# Owning Service: Backend Web Service
# Default: false
APP_DEBUG=false

# HOST
# Purpose: IP address the backend server binds to.
# Owning Service: Backend Web Service
# Default: 0.0.0.0 (required for Docker/Render container ingress)
HOST=0.0.0.0

# PORT
# Purpose: Port number the backend server listens on.
# Note: On Render, PORT is dynamically assigned and injected by Render.
# Owning Service: Backend Web Service
# Default: 8000 (local)
PORT=8000

# ------------------------------------------------------------------------------
# 2. CORS (Cross-Origin Resource Sharing) (Backend)
# ------------------------------------------------------------------------------
# CORS_ORIGINS
# Purpose: Whitelist of allowed web origins permitted to make cross-origin API calls.
# Format: Comma-separated URLs or JSON array string.
# Owning Service: Backend Web Service
# Local Default: http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Production: Add your deployed Render Static Site URL (e.g. https://epoclaim.onrender.com)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. SECURITY & ACCESS CONTROL (Backend)
# ------------------------------------------------------------------------------
# EPOCLAIM_API_KEY
# Purpose: Optional client API key protecting REST endpoints. When set, requests
#          must supply matching X-API-Key or Bearer header. If empty, public access is enabled.
# Owning Service: Backend Web Service
# Required: No (Optional)
EPOCLAIM_API_KEY=

# EPOCLAIM_ADMIN_API_KEY
# Purpose: Optional administrative key for privileged operations (e.g. cache clearance).
# Owning Service: Backend Web Service
# Required: No (Optional)
EPOCLAIM_ADMIN_API_KEY=

# MAX_BODY_BYTES
# Purpose: Maximum allowed request payload size in bytes (2MB default).
# Owning Service: Backend Web Service
# Default: 2097152
MAX_BODY_BYTES=2097152

# MAX_TEXT_CHARS
# Purpose: Maximum allowed characters in response_text or query.
# Owning Service: Backend Web Service
# Default: 100000
MAX_TEXT_CHARS=100000

# ------------------------------------------------------------------------------
# 4. PERSISTENCE & CACHING (Backend)
# ------------------------------------------------------------------------------
# DATABASE_URL
# Purpose: SQLAlchemy database connection string for persistence & caching.
# Note on Render: Web Service free tier has an ephemeral disk. EpoClaim operates
# statelessly for core verification. For cross-restart report persistence,
# attach a Render PostgreSQL instance or a Render Persistent Disk.
# Owning Service: Backend Web Service
# Default: sqlite:///./epoclaim.db
DATABASE_URL=sqlite:///./epoclaim.db

# ------------------------------------------------------------------------------
# 5. LIVE SEARCH & RETRIEVAL (Backend - Private Secret)
# ------------------------------------------------------------------------------
# TAVILY_API_KEY
# Purpose: Tavily Search API key for real-time web evidence retrieval.
# When empty: EpoClaim automatically operates in zero-credential offline mode,
#             using local reference documents and semantic cross-encoders.
# Owning Service: Backend Web Service (NEVER EXPOSE TO FRONTEND)
# Required: No (Optional for live search)
TAVILY_API_KEY=

# TAVILY_MAX_RESULTS
# Purpose: Maximum search results retrieved per Tavily search query.
# Default: 5
TAVILY_MAX_RESULTS=5

# TAVILY_SEARCH_DEPTH
# Purpose: Tavily search mode (basic | advanced).
# Default: basic
TAVILY_SEARCH_DEPTH=basic

# TAVILY_RATE_LIMIT_PER_MINUTE
# Purpose: Sliding-window rate limit for outbound Tavily API queries.
# Default: 2
TAVILY_RATE_LIMIT_PER_MINUTE=2

# TAVILY_CACHE_TTL_HOURS
# Purpose: Retention time for cached search queries.
# Default: 24.0
TAVILY_CACHE_TTL_HOURS=24.0

# ------------------------------------------------------------------------------
# 6. LLM GATEWAY / BIFROST / GEMINI (Backend - Private Secret)
# ------------------------------------------------------------------------------
# ENABLE_LLM_SEMANTIC_ASSESSMENT
# Purpose: Enable or disable optional LLM-assisted semantic assessment.
# When false: Pipeline operates 100% deterministically using local DeBERTa NLI.
# Owning Service: Backend Web Service
# Default: false
ENABLE_LLM_SEMANTIC_ASSESSMENT=false

# BIFROST_BASE_URL
# Purpose: OpenAI-compatible API gateway endpoint routing to Gemini or other LLMs.
# Example: http://localhost:8080/v1 or https://api.openai.com/v1
# Owning Service: Backend Web Service
# Default: ""
BIFROST_BASE_URL=

# BIFROST_MODEL
# Purpose: LLM model identifier (e.g. gemini-3.5-flash, gemini-1.5-flash, gpt-4o-mini).
# Owning Service: Backend Web Service
# Default: gpt-4o-mini
BIFROST_MODEL=gpt-4o-mini

# BIFROST_API_KEY
# Purpose: API key or bearer token for the LLM gateway.
# Owning Service: Backend Web Service (NEVER EXPOSE TO FRONTEND)
# Required: No (Optional)
BIFROST_API_KEY=

# BIFROST_TIMEOUT_SECONDS
# Purpose: Timeout for outbound LLM HTTP requests before falling back to local NLI.
# Default: 10.0
BIFROST_TIMEOUT_SECONDS=10.0

# BIFROST_MAX_RETRIES
# Purpose: Maximum retry attempts for transient 503/429 errors using exponential backoff with jitter.
# Default: 1
BIFROST_MAX_RETRIES=1

# ------------------------------------------------------------------------------
# 7. ADVANCED LLM MODULES (Backend - Optional)
# ------------------------------------------------------------------------------
# ENABLE_LLM_CLAIM_DECOMPOSITION
# Purpose: Enable LLM-assisted multi-proposition claim decomposition.
# Default: false
ENABLE_LLM_CLAIM_DECOMPOSITION=false

# ENABLE_LLM_ANSWER_CORRECTION
# Purpose: Enable LLM-assisted proposition-level grounded answer correction.
# Default: false
ENABLE_LLM_ANSWER_CORRECTION=false

# ------------------------------------------------------------------------------
# 8. TEMPORAL REASONING & VERDICT THRESHOLDS (Backend)
# ------------------------------------------------------------------------------
# DEFAULT_HALF_LIFE_HOURS
# Purpose: Half-life in hours for time-decayed evidence relevance weighting.
# Default: 168.0 (7 days)
DEFAULT_HALF_LIFE_HOURS=168.0

# RRF_K
# Purpose: Reciprocal Rank Fusion smoothing parameter.
# Default: 60
RRF_K=60

# ENTAILMENT_THRESHOLD
# Purpose: Minimum confidence score to issue a SUPPORTED verdict.
# Default: 0.65
ENTAILMENT_THRESHOLD=0.65

# CONTRADICTION_THRESHOLD
# Purpose: Minimum confidence score to issue an OUTDATED / CONTRADICTED verdict.
# Default: 0.60
CONTRADICTION_THRESHOLD=0.60

# ENABLE_CORRELATION_DISCOUNTED_SCORING
# Purpose: Activate correlation-aware redundant evidence discounting.
# Default: false
ENABLE_CORRELATION_DISCOUNTED_SCORING=false

# ------------------------------------------------------------------------------
# 9. PUBLIC FRONTEND CLIENT CONFIGURATION (Frontend)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL
# Purpose: Public HTTP URL of the deployed backend Web Service.
# Owning Service: Frontend Static Site (Public Client-Side)
# Security: This URL IS bundled into client JavaScript. Do NOT place secrets here!
# Local Development: Leave empty ("") to use Vite reverse proxy automatically.
# Render Production: In render.yaml, this is dynamically wired to the backend URL
#                    via fromService: envVarKey: RENDER_EXTERNAL_URL.
VITE_API_BASE_URL=
