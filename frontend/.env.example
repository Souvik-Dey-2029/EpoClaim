# ==============================================================================
# EpoClaim Frontend Environment Configuration Template
# Render Static Site Deployment
# ==============================================================================

# Production API Base URL
# Point this to your Render FastAPI Web Service URL (e.g. https://epoclaim-backend.onrender.com).
# Note: Do not append trailing /api or /api/v1 — EpoClaim's API client normalizes this automatically.
# In local development, leave this empty to use Vite's reverse proxy automatically.
VITE_API_BASE_URL=https://epoclaim-backend.onrender.com
