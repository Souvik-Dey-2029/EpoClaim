# EpoClaim Environment Configuration

# Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security
MAX_BODY_BYTES=2097152
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Storage
DATABASE_URL=sqlite:///./epoclaim.db

# Live Search Provider (Tavily)
# If left blank, EpoClaim operates in simulated / knowledge-base research mode.
TAVILY_API_KEY=

# Model Gateways & Providers
# Optional: Bifrost gateway endpoint or direct LLM endpoint
BIFROST_ENDPOINT=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Freshness Configuration
DEFAULT_HALF_LIFE_HOURS=168.0
TEMPORAL_RECENCY_WEIGHT=0.5
CONTRADICTION_PENALTY=0.8

