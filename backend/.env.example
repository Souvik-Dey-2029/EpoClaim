# ==============================================================================
# EpoClaim Backend Environment Configuration Template
# Global AI Hackathon — PS06: Stale-Answer Detector
# ==============================================================================

# --- Server & Runtime ---
# On Render Web Services, PORT is dynamically assigned by the container environment.
# HOST defaults to 0.0.0.0 for external binding in container environments.
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
APP_DEBUG=false

# --- CORS (Cross-Origin Resource Sharing) ---
# Comma-separated list of allowed frontend origins, or JSON array string.
# In Render production, add your Render Static Site URL (e.g. https://epoclaim.onrender.com).
# Supports '*' or comma-separated origins:
CORS_ORIGINS=https://epoclaim.onrender.com,http://localhost:5173,http://localhost:3000

# --- Security & Rate Limiting ---
# Optional: Developer API key to protect endpoints. When left empty, public access is permitted.
EPOCLAIM_API_KEY=
EPOCLAIM_ADMIN_API_KEY=
MAX_BODY_BYTES=2097152

# --- Storage & Persistence ---
# SQLite file path. On Render free instances, the filesystem is ephemeral per deploy/restart.
DATABASE_URL=sqlite:///./epoclaim.db

# --- Optional Search & Retrieval Integrations ---
# Live web research via Tavily (Optional). When empty, EpoClaim automatically operates
# in its high-performance deterministic local research & corpus mode without API consumption.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
TAVILY_RATE_LIMIT_PER_MINUTE=2
TAVILY_CACHE_TTL_HOURS=24.0

# --- Optional LLM Gateway / Bifrost ---
# When disabled or empty, EpoClaim uses its deterministic semantic verification engine.
ENABLE_LLM_SEMANTIC_ASSESSMENT=false
BIFROST_BASE_URL=
BIFROST_MODEL=gpt-4o-mini
BIFROST_API_KEY=
BIFROST_TIMEOUT_SECONDS=10.0

# --- Optional Advanced LLM Modules ---
ENABLE_LLM_CLAIM_DECOMPOSITION=false
ENABLE_LLM_ANSWER_CORRECTION=false

# --- Temporal Reasoning & Decay Parameters ---
DEFAULT_HALF_LIFE_HOURS=168.0
RRF_K=60
ENTAILMENT_THRESHOLD=0.65
CONTRADICTION_THRESHOLD=0.60
ENABLE_CORRELATION_DISCOUNTED_SCORING=false
